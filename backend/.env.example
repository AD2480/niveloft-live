# Niveloft backend environment variables (copy values into your shell, IDE run config or host).
# Never commit real secrets. Everything below the first block is optional for local development.

DB_URL=jdbc:mysql://localhost:3306/projectflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=projectflow
DB_PASSWORD=projectflow

# REQUIRED outside local development: the server refuses to start with the public default key
# when the database isn't on this machine. Generate with: openssl rand -base64 48
# JWT_SECRET=
JWT_EXPIRATION_SECONDS=86400

# The time zone that decides what "today" and "overdue" mean, and the dates in payment emails.
PROJECTFLOW_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5174
STORAGE_DIR=./data/uploads

# Swagger UI at /swagger-ui.html. Off by default; turn it on for local development only.
API_DOCS_ENABLED=true

# Sample data in an empty database: false for the live site (its sample password is public).
# Turn on only for local development.
DEMO_DATA=false

# --- Where the frontend lives (links in emails) --------------------------------------------
APP_URL=http://localhost:5174
SITE_NAME=Niveloft
# Where contact messages and "payment to check" emails go (shown at the bottom of emails too).
CONTACT_EMAIL=dobhalaaryam@gmail.com

# --- Email: confirm addresses, sign-in alerts, password reset --------------------------------
# none (nothing sent), log (written to the server log: copy links from there) or resend.
EMAIL_PROVIDER=log
# EMAIL_API_KEY=re_...            # Resend API key, server-side only
# EMAIL_FROM=Niveloft <no-reply@yourdomain.com>   # an address on a domain verified in Resend
# EMAIL_REPLY_TO=help@yourdomain.com
EMAIL_SIGN_IN_ALERTS=true
# auto = new accounts must confirm their email when EMAIL_PROVIDER=resend. Or true / false.
REQUIRE_EMAIL_VERIFICATION=auto
REGISTRATION_OPEN=true

# --- Bot protection and HTTPS ----------------------------------------------------------------
# Cloudflare Turnstile secret key (set VITE_TURNSTILE_SITE_KEY on the frontend too).
# TURNSTILE_SECRET_KEY=0x4AAAA...
# Proxies in front of the server that add to X-Forwarded-For: 1 on Railway/Render, 0 locally.
TRUSTED_PROXIES=0
# Redirect plain HTTP to HTTPS behind a proxy that sends X-Forwarded-Proto (true in production).
REQUIRE_HTTPS=false

# --- AI assistance ---------------------------------------------------------------------------
# auto (default): use a free Ollama model on this computer when it's running, found automatically.
#       Set it up with ./scripts/setup-local-ai.sh (or install Ollama and run: ollama pull llama3.2).
# ollama: the same, at AI_BASE_URL (e.g. http://gpu-box:11434).
# openai: anything that speaks OpenAI chat completions, including free tiers:
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Take AI_MODEL from the provider's current model list.
# anthropic: Claude (paid). Leave AI_BASE_URL unset.
# none: no server AI. People can still turn on the AI built into Chrome, and the built-in model
#       always answers, labelled as such.
AI_PROVIDER=auto
# AI_API_KEY=            # your provider key — server-side only, never sent to the browser (not needed for Ollama)
# AI_MODEL=              # leave unset with Ollama to pick automatically
# AI_BASE_URL=
AI_MAX_REQUESTS_PER_HOUR=30

# --- Limits and spending caps (0 turns one off) ------------------------------------------------
# Rate limits: over them the API answers 429 with Retry-After, and the app waits and retries.
API_REQUESTS_PER_MINUTE=300      # per signed-in person
API_ANONYMOUS_PER_MINUTE=120     # per IP address, without a sign-in
API_WRITES_PER_MINUTE=60         # changes per person
API_UPLOADS_PER_HOUR=60          # file uploads per person
API_MAX_JSON_KB=512              # largest JSON request body
# How much one project or person can hold.
MAX_TASKS_PER_PROJECT=5000
MAX_PROJECTS_PER_USER=100
MAX_MEMBERS_PER_PROJECT=200
STORAGE_MB_PER_PROJECT=1024
# Spending caps for the whole server (paid services). Reached: the feature says so and waits.
AI_MAX_REQUESTS_PER_DAY=1000
AI_MAX_TOKENS_PER_MONTH=5000000
EMAIL_MAX_PER_DAY=100            # Resend's free tier: 100 a day
EMAIL_MAX_PER_MONTH=3000         # and 3,000 a month
# Database connections and server threads.
DB_POOL_SIZE=10
SERVER_THREADS=200
# JSON logs (one object per line, with the request id) for a log service: ecs, gelf or logstash.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# --- The people who run this site ---------------------------------------------------------------
# Their accounts can open Site health (form success rates, sign-up sources from UTM tags, contact
# messages, spending). Comma-separated. Nobody when empty.
# They also approve UPI payments (Admin → Payments). Create this account straight after the first deploy.
# Contact form messages are saved for them, and also emailed to CONTACT_EMAIL when an email
# provider is set (EMAIL_PROVIDER=resend). Replying answers the sender.
OPERATOR_EMAILS=dobhalaaryam@gmail.com

# --- Paid plans, paid by UPI ---------------------------------------------------------------------
# Customers pay this UPI ID; you confirm each payment by its UTR in Admin → Payments.
BILLING_UPI_ID=dobhalaaryam-2@okhdfcbank
# The name UPI apps show for the payee.
BILLING_PAYEE_NAME=Niveloft
# Plan limits (Free: 3 active projects, 5 people per project). Leave on.
BILLING_ENFORCE_LIMITS=true
