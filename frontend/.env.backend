# Loaded by `npm run dev:api` (vite --mode backend): talk to the real Spring Boot API.
# /api is proxied by the Vite dev server to http://localhost:8080 (see vite.config.ts).
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/api
# Local development: the backend seeds sample accounts (DEMO_DATA=true), so list them on sign-in.
VITE_SHOW_SAMPLE_ACCOUNTS=true
